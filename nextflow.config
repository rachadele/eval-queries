/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pairwise Query-Query Label Transfer Pipeline — Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Load base config (SLURM executor, process labels)
includeConfig "$projectDir/conf/base.config"

// Load default parameters
includeConfig "$projectDir/conf/params.config"

// Load module-level config
includeConfig "$projectDir/conf/modules.config"

// DAG settings
dag.overwrite = true

// Trace settings
trace {
    enabled  = true
    file     = "${params.outdir}/trace.txt"
    overwrite = true
}

// Cleanup work directory after successful run
nextflow {
    clean {
        afterRun = true
    }
}

// Profiles
profiles {
    conda {
        conda.enabled = true
    }

    debug {
        process.beforeScript = 'echo $HOSTNAME'
        cleanup = false
    }
}

workDir = '/cosmos/data/nextflow-eval-pipeline-work'

// Manifest
manifest {
    name            = 'query-query-benchmark'
    author          = 'rschwartz'
    homePage        = ''
    description     = 'Pairwise query-query label transfer benchmarking pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
