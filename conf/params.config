/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default parameter values — Pairwise Query-Query Pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {

    // Census SCVI model
    organism       = "mus_musculus"
    census_version = "2025-01-30"

    // Input data globs (set via params file or command line)
    queries_adata = null   // glob matching per-sample h5ad files
    relabel_q     = null   // glob matching <study_key>_relabel.tsv files
    relabel_r     = "$projectDir/meta/census_map_mouse_author.tsv"

    // Region mapping for classify_all
    ref_region_mapping = "$projectDir/meta/query_region_mapping.yaml"

    // Label hierarchy
    ref_keys = ["subclass", "class", "family", "global"]

    // Aggregation: subsample this many cells per cell type when building study reference
    subsample_ref = 500

    // QC
    nmads         = 5
    remove_unknown = true

    // Classification
    cutoff  = 0
    use_gap = true
    seed    = 42

    // Seurat parameters
    normalization_method = "SCT"
    nfeatures            = 2000
    integration_method   = "pcaproject"
    dims                 = 50
    max_features         = 200
    k_anchor             = 10
    k_score              = 30
    k_weight             = 50

    // Batch keys per study (fallback: "sample_id")
    batch_keys = [
        "GSE124952":   "sample_id",
        "GSE181021":   "batch",
        "GSE185454":   "sample_id",
        "GSE199460":   "sample_id",
        "GSE214244":   "sample_id",
        "GSE247339":   "sample_id"
    ]

    // Cell types of interest for pairwise detail plot
    target_celltypes = ["Microglia", "OPC", "Neural stem cell", "Oligodendrocyte"]

    // Resource files
    gene_mapping     = "$projectDir/assets/gemma_genes.tsv"
    multiqc_config   = "$projectDir/assets/multiqc_config.yaml"

    // Output directory
    outdir_prefix = "query_query/${params.organism}/${params.subsample_ref}/${params.normalization_method}/gap_${params.use_gap}"
    outdir        = "$projectDir/${params.outdir_prefix}/cutoff_${params.cutoff}"
}
